<!DOCTYPE html>
<html lang="en">
<head>
  <title>{{ shop.name }} | Welcome to Wave Bye!</title>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <meta name="viewport" content="width=device-width">
</head>
<body style="margin: 0; padding: 0; font-family: Arial, sans-serif; line-height: 1.6; color: #0a1f44;">
  <table width="100%" border="0" cellspacing="0" cellpadding="0" style="background-color: #f9f9f9; padding: 20px;">
    <tr>
      <td align="center">
        <table width="600" border="0" cellspacing="0" cellpadding="0" style="background-color: #ffffff; border-radius: 5px; overflow: hidden;">
          <!-- Header -->
          <tr>
            <td align="center" style="padding: 20px; background-color: #0a1f44;">
              {% if shop.email_logo_url %}
                <img src="{{ shop.email_logo_url }}" alt="{{ shop.name }}" width="{{ shop.email_logo_width }}" style="max-width: 200px; height: auto;">
              {% else %}
                <h1 style="color: #ffffff; font-size: 24px; margin: 0;">{{ shop.name }}</h1>
              {% endif %}
            </td>
          </tr>

          <!-- Title -->
          <tr>
            <td align="center" style="padding: 20px 20px 10px 20px;">
              <h1 style="font-size: 24px; font-weight: bold; color: #0a1f44; margin: 0;">Welcome to Wave Bye! It’s time for your new period!</h1>
            </td>
          </tr>

          <!-- Main Content -->
          <tr>
            <td style="padding: 20px;">
              <p style="font-size: 16px; margin: 0 0 10px; color: #0a1f44;">Hi {{ customer.first_name }},</p>
              <p style="font-size: 16px; margin: 0 0 20px; color: #0a1f44;">Welcome to Wave Bye! We’re excited and grateful to have you as part of our community. Period pain and other troublesome symptoms have been acceptable for far too long. Let a new wave begin!</p>
              <p style="text-align: center; margin: 20px 0;">
                <a href="{{ shop.url }}" style="font-size: 16px; text-decoration: none; padding: 10px 20px; background-color: #0a1f44; color: #ffffff; border-radius: 5px;">Shop Now</a>
              </p>
